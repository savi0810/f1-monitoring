{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "telemetry": {
        "ClusterId": "telemetry",
        "Match": { "Path": "/api/telemetry/{**catch-all}" }
      },
      "alerts": {
        "ClusterId": "alerts",
        "Match": { "Path": "/api/alerts/{**catch-all}" }
      },
      "live": {
        "ClusterId": "live",
        "Match": { "Path": "/livehub/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "auth-api": { "Address": "http://auth-api:8080" } }
      },
      "telemetry": {
        "Destinations": { "telemetry-api": { "Address": "http://telemetry-api:8080" } }
      },
      "alerts": {
        "Destinations": { "alerts-api": { "Address": "http://alerts-api:8080" } }
      },
      "live": {
        "Destinations": { "live-api": { "Address": "http://live-api:8080" } }
      }
    }
  }
}
